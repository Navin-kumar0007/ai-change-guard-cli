// Data extraction golden set: each prompt asks for JSON, checked against a JSON schema. Copy it and replace the inputs with your own.
// Fields: id, input (or messages), system, tools, expect { json, schema, tool, contains }, max_tokens, temperature, json_mode.
{"id": "invoice-basic", "system": "Extract the fields as JSON only, with no other text. Use null for anything the text does not say. Keys: invoice_number (string), total (number), currency (ISO code), due_date (YYYY-MM-DD).", "input": "Invoice INV-2207 from Acme Supplies. Amount due: $1,240.50. Please pay by 15 January 2027.", "json_mode": true, "expect": {"schema": {"type": "object", "required": ["invoice_number", "total", "currency", "due_date"], "properties": {"invoice_number": {"type": "string"}, "total": {"type": "number"}, "currency": {"type": "string"}, "due_date": {"type": ["string", "null"]}}}}}
