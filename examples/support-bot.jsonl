// Support bot golden set (10 prompts): one real prompt per line. Copy this file and replace the prompts with your own.
// Fields: id, input (or messages), system, tools, expect { json, schema, tool, contains }, max_tokens, temperature, json_mode.
{"id":"shipping-time","system":"You are the support assistant for an online store. Answer in one or two sentences.","input":"How long does shipping take?"}
{"id":"refund-policy","system":"You are the support assistant for an online store. Answer in one or two sentences.","input":"Can I get a refund on an opened item?","expect":{"contains":["30 days"]}}
{"id":"order-json","system":"Extract the order details as JSON with keys order_id (string) and items (list of strings).","input":"Order #A-1042: 2 mugs and a teapot.","json_mode":true,"expect":{"schema":{"type":"object","required":["order_id","items"],"properties":{"order_id":{"type":"string"},"items":{"type":"array","items":{"type":"string"}}}}}}
{"id":"router-reset","system":"You are a home-internet support assistant.","input":"My wifi keeps dropping. What should I try first?"}
{"id":"cancel-order","system":"Use the tools to act on the customer's request.","input":"Please cancel order A-1042.","tools":[{"name":"cancel_order","parameters":{"type":"object","required":["order_id"],"properties":{"order_id":{"type":"string"}}}},{"name":"escalate","parameters":{"type":"object","properties":{"reason":{"type":"string"}}}}],"expect":{"tool":"cancel_order"}}
{"id": "change-address", "system": "You are the support assistant for an online store. Answer in one or two sentences.", "input": "I moved. Can I change the delivery address on an order I placed an hour ago?"}
{"id": "damaged-item", "system": "You are the support assistant for an online store. Answer in one or two sentences.", "input": "My teapot arrived cracked. What do I do?", "expect": {"contains": ["photo"]}}
{"id": "escalate-angry", "system": "Use the tools to act on the customer's request.", "input": "This is the third time my order is late. I want to speak to a manager now.", "tools": [{"name": "cancel_order", "parameters": {"type": "object", "required": ["order_id"], "properties": {"order_id": {"type": "string"}}}}, {"name": "escalate", "parameters": {"type": "object", "properties": {"reason": {"type": "string"}}}}], "expect": {"tool": "escalate"}}
{"id": "order-status-json", "system": "Classify the message as JSON with keys intent (one of track_order, return, other) and order_id (string or null).", "input": "Where is my package? Order B-2219.", "json_mode": true, "expect": {"schema": {"type": "object", "required": ["intent", "order_id"], "properties": {"intent": {"enum": ["track_order", "return", "other"]}, "order_id": {"type": ["string", "null"]}}}}}
{"id": "out-of-scope", "system": "You are the support assistant for an online store. Answer in one or two sentences. Only help with orders, shipping and returns.", "input": "Can you write my college essay for me?"}
