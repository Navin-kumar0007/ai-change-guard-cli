// Summariser golden set: each prompt asks for a short summary; checks look for the facts that must survive and cap the length. Copy it and use your own documents.
// Fields: id, input (or messages), system, tools, expect { json, schema, tool, contains }, max_tokens, temperature, json_mode.
{"id": "news-earnings", "system": "Summarise the text in at most two sentences. Keep every number, date and name that matters.", "input": "Northwind Traders reported third-quarter revenue of $412 million, up 9% from a year earlier, and raised its full-year forecast to $1.6 billion. Shares rose 4% in early trading. The company said demand from Southeast Asia drove most of the growth.", "max_tokens": 120, "expect": {"contains": ["412", "9%"]}}
{"id": "policy-change", "system": "Summarise the text in at most two sentences. Keep every number, date and name that matters.", "input": "From 1 March 2027, employees can work remotely up to three days a week. Requests must be approved by a line manager. Teams that handle customer data on site are excluded until the security review ends in June.", "max_tokens": 120, "expect": {"contains": ["1 March 2027", "three days"]}}
{"id": "incident-report", "system": "Summarise the text in at most two sentences. Keep every number, date and name that matters.", "input": "At 02:14 UTC the payments API began returning 503 errors after a database failover. Engineers rolled back the configuration change at 02:41 and service recovered by 02:47. About 1,900 payments failed and were retried automatically.", "max_tokens": 120, "expect": {"contains": ["1,900"]}}
{"id": "meeting-notes", "system": "Summarise the text in at most two sentences. Keep every number, date and name that matters.", "input": "Decisions: launch moves to 20 January. Owner for the pricing page is Arjun. We drop the Android widget from v1. Next check-in Monday.", "max_tokens": 120, "expect": {"contains": ["20 January", "Arjun"]}}
{"id": "research-abstract", "system": "Summarise the text in at most two sentences. Keep every number, date and name that matters.", "input": "We fine-tune a 1.3B-parameter model on 40,000 support transcripts and compare it with a general model 10 times larger. The smaller model resolves 71% of test tickets against 64% for the larger one, at one eighth of the cost per ticket.", "max_tokens": 120, "expect": {"contains": ["71%"]}}
{"id": "product-review", "system": "Summarise the text in at most two sentences. Keep every number, date and name that matters.", "input": "The headphones sound great and the battery lasts the claimed 30 hours, but the ear cups get uncomfortable after an hour and the app keeps logging me out. Returning them.", "max_tokens": 120, "expect": {"contains": ["30 hours"]}}
{"id": "support-thread", "system": "Summarise the support conversation for the next agent in three bullet points: the problem, what was tried, what is still open.", "input": "Customer: My invoices stopped syncing to Xero yesterday.\nAgent: I reconnected the integration from our side.\nCustomer: Still nothing for invoices after 25 Nov.\nAgent: Escalating to the integrations team.", "max_tokens": 160, "expect": {"contains": ["Xero"]}}
{"id": "support-thread-resolved", "system": "Summarise the support conversation for the next agent in three bullet points: the problem, what was tried, what is still open.", "input": "Customer: I can't log in, it says my account is locked.\nAgent: I've unlocked it and sent a reset link.\nCustomer: Reset worked, I'm in. But 2FA codes arrive late.\nAgent: Noted, checking with the SMS provider.", "max_tokens": 160, "expect": {"contains": ["2FA"]}}
{"id": "contract-clause", "system": "Summarise the text in at most two sentences. Keep every number, date and name that matters.", "input": "Either party may terminate this agreement with 60 days' written notice. Fees paid for the current billing period are non-refundable, except where the Supplier fails to meet the 99.5% uptime commitment for two consecutive months.", "max_tokens": 120, "expect": {"contains": ["60 days", "99.5%"]}}
{"id": "email-request", "system": "Summarise the text in at most two sentences. Keep every number, date and name that matters.", "input": "Hi team, the client needs the revised quote by Friday 5 pm, with the extra 20 licences priced separately and the onboarding fee waived as agreed on the call. Thanks, Meera", "max_tokens": 120, "expect": {"contains": ["Friday", "20 licences"]}}
